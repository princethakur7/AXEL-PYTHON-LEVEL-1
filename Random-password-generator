import random
import string

# Function to generate password
def generate_password(length, use_upper, use_lower, use_numbers, use_symbols):

    characters = ""

    # Adding uppercase letters
    if use_upper:
        characters += string.ascii_uppercase

    # Adding lowercase letters
    if use_lower:
        characters += string.ascii_lowercase

    # Adding numbers
    if use_numbers:
        characters += string.digits

    # Adding symbols
    if use_symbols:
        characters += string.punctuation

    # Checking if user selected at least one option
    if characters == "":
        print("\nPlease select at least one character type.")
        return None

    # Generating password
    password = ""

    for i in range(length):
        password += random.choice(characters)

    return password


# Function to check password strength
def check_strength(password):

    strength = 0

    if len(password) >= 8:
        strength += 1

    if any(char.isupper() for char in password):
        strength += 1

    if any(char.islower() for char in password):
        strength += 1

    if any(char.isdigit() for char in password):
        strength += 1

    if any(char in string.punctuation for char in password):
        strength += 1

    # Displaying strength
    if strength == 5:
        return "Very Strong"

    elif strength >= 3:
        return "Strong"

    elif strength >= 2:
        return "Medium"

    else:
        return "Weak"


# Main Program
print("===================================")
print("      PASSWORD GENERATOR")
print("===================================")

while True:

    # Taking password length
    length = int(input("\nEnter password length: "))

    # User choices
    upper = input("Include Uppercase Letters? (yes/no): ").lower() == "yes"

    lower = input("Include Lowercase Letters? (yes/no): ").lower() == "yes"

    numbers = input("Include Numbers? (yes/no): ").lower() == "yes"

    symbols = input("Include Symbols? (yes/no): ").lower() == "yes"

    # Number of passwords
    total = int(input("How many passwords do you want to generate? "))

    print("\nGenerated Passwords:\n")

    for i in range(total):

        password = generate_password(
            length,
            upper,
            lower,
            numbers,
            symbols
        )

        if password:

            print(f"{i+1}. {password}")

            # Checking strength
            strength = check_strength(password)

            print("   Strength:", strength)

            # Saving password to file
            file = open("passwords.txt", "a")
            file.write(password + "\n")
            file.close()

    # Asking user to continue
    again = input("\nDo you want to generate more passwords? (yes/no): ").lower()

    if again != "yes":
        print("\nThank You For Using Password Generator")
        break
